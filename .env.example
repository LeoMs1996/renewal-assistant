# ===== LLM =====
# Anthropic Claude（续保助手主模型）
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===== MCP =====
# MCP quote 服务器地址（保单/报价工具）
MCP_QUOTE_SERVER_URL=http://127.0.0.1:9100/mcp

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
TRACE_DIR=./traces

# ===== 数据（合成） =====
SYNTHETIC_DIR=./synthetic
WIKI_DIR=./wiki

# ===== LLM（GLM，Anthropic 兼容接口；与上面 ANTHROPIC_* 二选一，本组优先） =====
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_AUTH_TOKEN=your-glm-token
# MODEL_NAME=glm-4.6

# ===== 安全（v1.0.6，安全域 t9）=====
# API-Key 表：逗号分隔的 key:owner_id。留空 = 演示模式（匿名放行 + X-Auth-Mode: demo）。
# 生产必须配置；密钥建议 >=32 字符随机串，按车主一人一钥。
# RENEWAL_API_KEYS=key-owner1001-xxxxxxxx:OWN-1001,key-owner1002-yyyyyyyy:OWN-1002
#
# 限流：按 IP 的 1 分钟滑动窗口。/chat 走独立计数桶（不与其他端点互相占额度）。
# RENEWAL_RATE_LIMIT_PER_MIN=60
# RENEWAL_CHAT_RATE_LIMIT_PER_MIN=60
# 压测/全量回归专用开关：1 = 完全关闭限流（启动日志留痕，生产禁开）
# RENEWAL_RATE_LIMIT_DISABLED=0
#
# 入参上限（字符数）：超限回 422 INVALID_INPUT（OWASP LLM10 输入校验）
# RENEWAL_MAX_MESSAGE_CHARS=4000
#
# 文档入口：1 = 允许匿名访问 /docs /redoc /openapi.json（仅本地开发；默认关闭）
# RENEWAL_EXPOSE_DOCS=0
#
# 轨迹 PII：默认 redact（写端+读端脱敏）；keep 仅本机调试，生产禁开
# RENEWAL_TRACE_PII=redact
